{
  "target": "Violate HACKDAC_p39: when ct_valid is asserted, all p_c[] registers must be 0. Find a state where ct_valid==1 but at least one p_c[i] != 0.",
  "target_expr": "top_wrapper_dac21.aes0_wrapper_i.ct_valid == 1 && (top_wrapper_dac21.aes0_wrapper_i.p_c[0] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[1] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[2] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[3] != 0)",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, AES0 wrapper active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "AES encryption in progress, plaintext loaded into p_c registers",
      "condition": "top_wrapper_dac21.aes0_wrapper_i.p_c[0] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[1] != 0",
      "expected_cycles": 5
    },
    {
      "step": 3,
      "description": "Violation: ct_valid asserted (encryption done) but p_c registers still hold plaintext — not cleared after encryption",
      "condition": "top_wrapper_dac21.aes0_wrapper_i.ct_valid == 1 && (top_wrapper_dac21.aes0_wrapper_i.p_c[0] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[1] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[2] != 0 || top_wrapper_dac21.aes0_wrapper_i.p_c[3] != 0)",
      "expected_cycles": 3
    }
  ]
}
