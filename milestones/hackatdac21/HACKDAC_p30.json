{
  "target": "Violate HACKDAC_p30: when pass_mode is asserted, pass_data must equal data_d. Find a state where pass_mode==1 but pass_data != data_d (hardcoded key mismatch).",
  "target_expr": "top_wrapper_dac21.dmi_jtag_i.pass_mode == 1 && top_wrapper_dac21.dmi_jtag_i.pass_data != top_wrapper_dac21.dmi_jtag_i.data_d",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, JTAG active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "JTAG enters password mode (pass_mode asserted)",
      "condition": "top_wrapper_dac21.dmi_jtag_i.pass_mode == 1",
      "expected_cycles": 4
    },
    {
      "step": 3,
      "description": "Violation: pass_mode active but pass_data does not match data_d — hardcoded key allows bypass",
      "condition": "top_wrapper_dac21.dmi_jtag_i.pass_mode == 1 && top_wrapper_dac21.dmi_jtag_i.pass_data != top_wrapper_dac21.dmi_jtag_i.data_d",
      "expected_cycles": 3
    }
  ]
}
