{
  "target": "Violate HACKDAC_p7: debug_mode_q must not be asserted (or PRIV_LVL_M must hold). Find a state where debug_mode_q==1 (and PRIV_LVL_M is 0, i.e., not machine mode).",
  "target_expr": "top_wrapper_dac21.ariane_i.csr_regfile_i.debug_mode_q == 1",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, debug_mode_q is 0",
      "condition": "rst_ni == 1 && top_wrapper_dac21.ariane_i.csr_regfile_i.debug_mode_q == 0",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "Debug request arrives",
      "condition": "top_wrapper_dac21.debug_req_i == 1",
      "expected_cycles": 3
    },
    {
      "step": 3,
      "description": "Violation: debug_mode_q asserted — incorrect access control leaves debug enabled",
      "condition": "top_wrapper_dac21.ariane_i.csr_regfile_i.debug_mode_q == 1",
      "expected_cycles": 3
    }
  ]
}
