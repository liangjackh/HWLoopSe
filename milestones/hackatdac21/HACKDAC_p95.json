{
  "target": "Violate HACKDAC_p95: when rst_ni==1 and rst_13==0 (soft reset), msg_out must be 0. Find a state where rst_ni==1, rst_13==0, but msg_out != 0.",
  "target_expr": "top_wrapper_dac21.rsa_wrapper_i.rst_ni == 1 && top_wrapper_dac21.rsa_wrapper_i.rst_13 == 0 && top_wrapper_dac21.rsa_wrapper_i.msg_out != 0",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, RSA wrapper active with msg_out holding a value",
      "condition": "rst_ni == 1 && top_wrapper_dac21.rsa_wrapper_i.msg_out != 0",
      "expected_cycles": 3
    },
    {
      "step": 2,
      "description": "Soft reset issued (rst_13 deasserted to 0)",
      "condition": "top_wrapper_dac21.rsa_wrapper_i.rst_ni == 1 && top_wrapper_dac21.rsa_wrapper_i.rst_13 == 0",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: soft reset applied but msg_out still non-zero — decrypted RSA output not cleared after soft reset",
      "condition": "top_wrapper_dac21.rsa_wrapper_i.rst_ni == 1 && top_wrapper_dac21.rsa_wrapper_i.rst_13 == 0 && top_wrapper_dac21.rsa_wrapper_i.msg_out != 0",
      "expected_cycles": 2
    }
  ]
}
