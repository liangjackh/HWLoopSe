{
  "target": "Violate HACKDAC_p46: when debug_mode_i is asserted, key_big and key_big2 must both be 0. Find a state where debug_mode_i==1 but key_big or key_big2 is non-zero.",
  "target_expr": "top_wrapper_dac21.aes0_wrapper_i.debug_mode_i == 1 && (top_wrapper_dac21.aes0_wrapper_i.key_big != 0 || top_wrapper_dac21.aes0_wrapper_i.key_big2 != 0)",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, AES0 wrapper active with keys loaded",
      "condition": "rst_ni == 1 && (top_wrapper_dac21.aes0_wrapper_i.key_big != 0 || top_wrapper_dac21.aes0_wrapper_i.key_big2 != 0)",
      "expected_cycles": 3
    },
    {
      "step": 2,
      "description": "Debug mode asserted",
      "condition": "top_wrapper_dac21.aes0_wrapper_i.debug_mode_i == 1",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: debug_mode_i asserted but AES key registers not zeroed — sensitive key data exposed in debug mode",
      "condition": "top_wrapper_dac21.aes0_wrapper_i.debug_mode_i == 1 && (top_wrapper_dac21.aes0_wrapper_i.key_big != 0 || top_wrapper_dac21.aes0_wrapper_i.key_big2 != 0)",
      "expected_cycles": 2
    }
  ]
}
