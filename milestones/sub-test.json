{
  "target": "Violate assertion 'b_out == (past_3_in_a + 1)' in u_assert",
  "target_expr": "u_assert.b_out != (u_assert.past_3_in_a + 1)",
  "milestones": [
    {
      "step": 0,
      "description": "System Reset",
      "condition": "rst_n == 0"
    },
    {
      "step": 1,
      "description": "Reset released, first clock cycle after reset",
      "condition": "rst_n == 1 && u_assert.valid_pipe == 1"
    },
    {
      "step": 2,
      "description": "Second clock cycle after reset, valid pipeline advances",
      "condition": "rst_n == 1 && u_assert.valid_pipe == 3"
    },
    {
      "step": 3,
      "description": "Third clock cycle after reset, check_en becomes 1, past_3_in_a is defined",
      "condition": "rst_n == 1 && u_assert.check_en == 1 && u_assert.past_3_in_a <= 10"
    },
    {
      "step": 4,
      "description": "Verification target: b_out != (past_3_in_a + 1) when past_3_in_a <= threshold",
      "condition": "u_assert.b_out != (u_assert.past_3_in_a + 1) && u_assert.past_3_in_a <= 10"
    }
  ]
