{
  "target": "Violate HACKDAC_p29: when instret_q changes, debug_mode_q must be 1. Find a state where instret_q incremented but debug_mode_q is 0.",
  "target_expr": "formal_top.dut.ariane_i.csr_regfile_i.instret_q != formal_top.dut.ariane_i.csr_regfile_i.instret_q && formal_top.dut.ariane_i.csr_regfile_i.debug_mode_q == 0",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, instret_q initialized to 0",
      "condition": "rst_ni == 1 && formal_top.dut.ariane_i.csr_regfile_i.instret_q == 0",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "Processor not in debug mode, executing instructions normally",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.debug_mode_q == 0",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: instret_q increments (instruction retired) while debug_mode_q is 0 — counter updated outside debug mode",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.instret_q > 0 && formal_top.dut.ariane_i.csr_regfile_i.debug_mode_q == 0",
      "expected_cycles": 3
    }
  ]
}
