{
  "target": "Violate HACKDAC_p21: when amo_valid_commit_o is asserted, exception_o must differ from csr_exception_i. Find a state where amo_valid_commit_o==1 but exception_o == csr_exception_i.",
  "target_expr": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1 && formal_top.dut.ariane_i.commit_stage_i.exception_o == formal_top.dut.ariane_i.commit_stage_i.csr_exception_i",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, commit stage active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "An AMO instruction reaches the commit stage",
      "condition": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1",
      "expected_cycles": 5
    },
    {
      "step": 3,
      "description": "Violation: AMO commit active but exception_o equals csr_exception_i — CSR interrupt incorrectly propagated during atomic commit",
      "condition": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1 && formal_top.dut.ariane_i.commit_stage_i.exception_o == formal_top.dut.ariane_i.commit_stage_i.csr_exception_i",
      "expected_cycles": 2
    }
  ]
}
