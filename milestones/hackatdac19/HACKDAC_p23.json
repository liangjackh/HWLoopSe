{
  "target": "Violate HACKDAC_p23: when amo_valid_commit is asserted, all three flush signals must be high. Find a state where amo_valid_commit==1 but at least one flush signal is 0.",
  "target_expr": "formal_top.dut.ariane_i.amo_valid_commit == 1 && (formal_top.dut.ariane_i.flush_ctrl_if == 0 || formal_top.dut.ariane_i.flush_ctrl_id == 0 || formal_top.dut.ariane_i.flush_ctrl_ex == 0)",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, pipeline active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "AMO instruction committed at top level",
      "condition": "formal_top.dut.ariane_i.amo_valid_commit == 1",
      "expected_cycles": 5
    },
    {
      "step": 3,
      "description": "Violation: AMO committed but pipeline not fully flushed — at least one of flush_ctrl_if/id/ex is 0",
      "condition": "formal_top.dut.ariane_i.amo_valid_commit == 1 && (formal_top.dut.ariane_i.flush_ctrl_if == 0 || formal_top.dut.ariane_i.flush_ctrl_id == 0 || formal_top.dut.ariane_i.flush_ctrl_ex == 0)",
      "expected_cycles": 2
    }
  ]
}
