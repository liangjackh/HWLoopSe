{
  "target": "Violate HACKDAC_p22: when amo_valid_commit_o is asserted, commit_ack_o[1] must be 0. Find a state where amo_valid_commit_o==1 AND commit_ack_o[1]==1.",
  "target_expr": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1 && formal_top.dut.ariane_i.commit_stage_i.commit_ack_o[1] == 1",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, commit stage active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "An AMO instruction reaches the commit stage",
      "condition": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1",
      "expected_cycles": 5
    },
    {
      "step": 3,
      "description": "Violation: AMO commit active and commit_ack_o[1] is also asserted — second instruction incorrectly committed alongside atomic",
      "condition": "formal_top.dut.ariane_i.commit_stage_i.amo_valid_commit_o == 1 && formal_top.dut.ariane_i.commit_stage_i.commit_ack_o[1] == 1",
      "expected_cycles": 2
    }
  ]
}
