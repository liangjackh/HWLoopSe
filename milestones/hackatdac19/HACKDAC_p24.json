{
  "target": "Violate HACKDAC_p24: when tvm_o is asserted, csr_rdata_o must not equal satp_q. Find a state where tvm_o==1 AND csr_rdata_o == satp_q.",
  "target_expr": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1 && formal_top.dut.ariane_i.csr_regfile_i.csr_rdata_o == formal_top.dut.ariane_i.csr_regfile_i.satp_q",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, CSR file active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "TVM bit is set in mstatus, tvm_o asserted",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1",
      "expected_cycles": 4
    },
    {
      "step": 3,
      "description": "Violation: TVM enabled but SATP read returns satp_q value — supervisor can read SATP despite TVM restriction",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1 && formal_top.dut.ariane_i.csr_regfile_i.csr_rdata_o == formal_top.dut.ariane_i.csr_regfile_i.satp_q",
      "expected_cycles": 3
    }
  ]
}
