{
  "target": "Violate HACKDAC_p25: when tvm_o is asserted, satp_d must not equal csr_wdata_i. Find a state where tvm_o==1 AND satp_d == csr_wdata_i.",
  "target_expr": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1 && formal_top.dut.ariane_i.csr_regfile_i.satp_d == formal_top.dut.ariane_i.csr_regfile_i.csr_wdata_i",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, CSR file active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "TVM bit set, tvm_o asserted, and a CSR write is in progress",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1 && formal_top.dut.ariane_i.csr_regfile_i.csr_we == 1",
      "expected_cycles": 4
    },
    {
      "step": 3,
      "description": "Violation: TVM enabled but satp_d takes the write data value — supervisor can write SATP despite TVM restriction",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.tvm_o == 1 && formal_top.dut.ariane_i.csr_regfile_i.satp_d == formal_top.dut.ariane_i.csr_regfile_i.csr_wdata_i",
      "expected_cycles": 3
    }
  ]
}
