{
  "target": "Violate HACKDAC_p32: when halt_o is asserted, ex_valid_i must also be asserted. Find a state where halt_o==1 but ex_valid_i==0.",
  "target_expr": "formal_top.dut.ariane_i.controller_i.halt_o == 1 && formal_top.dut.ariane_i.controller_i.ex_valid_i == 0",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, controller active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "Controller receives a halt request (e.g., debug halt)",
      "condition": "formal_top.dut.ariane_i.controller_i.halt_o == 1",
      "expected_cycles": 4
    },
    {
      "step": 3,
      "description": "Violation: halt_o asserted but ex_valid_i is 0 — exception signal not set at halt",
      "condition": "formal_top.dut.ariane_i.controller_i.halt_o == 1 && formal_top.dut.ariane_i.controller_i.ex_valid_i == 0",
      "expected_cycles": 2
    }
  ]
}
