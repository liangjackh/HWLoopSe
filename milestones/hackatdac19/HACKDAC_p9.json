{
  "target": "Violate HACKDAC_p9: when a CSR read/write targets CSR_MEPC (0x341), csr_exception_o.valid must be 1. Find a state where csr_we or csr_read targets MEPC but no exception is raised.",
  "target_expr": "(formal_top.dut.ariane_i.csr_regfile_i.csr_we == 1 || formal_top.dut.ariane_i.csr_regfile_i.csr_read == 1) && formal_top.dut.ariane_i.csr_regfile_i.csr_addr.address == 12'h341 && formal_top.dut.ariane_i.csr_regfile_i.csr_exception_o.valid == 0",
  "milestones": [
    {
      "step": 0,
      "description": "System in reset",
      "condition": "rst_ni == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted, processor active",
      "condition": "rst_ni == 1",
      "expected_cycles": 2
    },
    {
      "step": 2,
      "description": "Processor issues a CSR access (csr_we or csr_read asserted)",
      "condition": "formal_top.dut.ariane_i.csr_regfile_i.csr_we == 1 || formal_top.dut.ariane_i.csr_regfile_i.csr_read == 1",
      "expected_cycles": 4
    },
    {
      "step": 3,
      "description": "Violation: CSR access targets MEPC (0x341) but csr_exception_o.valid is 0 — user mode can access machine-level CSR without exception",
      "condition": "(formal_top.dut.ariane_i.csr_regfile_i.csr_we == 1 || formal_top.dut.ariane_i.csr_regfile_i.csr_read == 1) && formal_top.dut.ariane_i.csr_regfile_i.csr_addr.address == 12'h341 && formal_top.dut.ariane_i.csr_regfile_i.csr_exception_o.valid == 0",
      "expected_cycles": 3
    }
  ]
}
