{
  "target": "Violate assertion HACKDAC_p2: ~(((TCDM_data_gnt_DEM_TO_XBAR) >> 1) && ((TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) && (TCDM_data_add_DEM_TO_XBAR <= 32'h1C08_0000))) in jg_bind_inst",
  "target_expr": "((soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR >> 1) != 0) && (soc_interconnect.TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) && (soc_interconnect.TCDM_data_add_DEM_TO_XBAR <= 32'h1C08_0000)",
  "milestones": [
    {
      "step": 0,
      "description": "System reset: rst_n is low, all registers in reset state.",
      "condition": "rst_n == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset deasserted: system becomes active.",
      "condition": "rst_n == 1",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "A master with index >= 1 (e.g., FC_DATA at index 4) issues a request with address in the TCDM region [0x1C00_0000, 0x1C08_0000].",
      "condition": "FC_DATA_req_i == 1 && FC_DATA_add_i >= 32'h1C00_0000 && FC_DATA_add_i <= 32'h1C08_0000",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "The demux routes the request to the TCDM path: TCDM_data_add_DEM_TO_XBAR[4] is set to the requested address.",
      "condition": "TCDM_data_add_DEM_TO_XBAR[4] >= 32'h1C00_0000 && TCDM_data_add_DEM_TO_XBAR[4] <= 32'h1C08_0000",
      "expected_cycles": 1
    },
    {
      "step": 4,
      "description": "XBAR_L2 grants the request: TCDM_data_gnt_DEM_TO_XBAR[4] == 1. Since index 4 >= 1, (gnt >> 1) is non-zero. The address is in range. The assertion is violated.",
      "condition": "TCDM_data_gnt_DEM_TO_XBAR[4] == 1 && TCDM_data_add_DEM_TO_XBAR[4] >= 32'h1C00_0000 && TCDM_data_add_DEM_TO_XBAR[4] <= 32'h1C08_0000",
      "expected_cycles": 2
    }
  ]
}
