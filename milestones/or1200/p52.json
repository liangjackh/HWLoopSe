{
  "target": "Violate p52: or1200_cpu.operand_b must equal or1200_cpu.dcpu_dat_o",
  "target_expr": "!(or1200_cpu.operand_b == or1200_cpu.dcpu_dat_o || or1200_cpu.rst == 1)",
  "milestones": [
    {
      "step": 0,
      "description": "Reset asserted",
      "condition": "or1200_cpu.rst == 1",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released",
      "condition": "or1200_cpu.rst == 0",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "Store instruction reaches EX stage (opcode 35=l.sw)",
      "condition": "((or1200_cpu.ex_insn & 32'hFC000000) >> 26) == 35 && or1200_cpu.rst == 0",
      "expected_cycles": 3
    },
    {
      "step": 3,
      "description": "Violation: or1200_cpu.operand_b does not equal or1200_cpu.dcpu_dat_o",
      "condition": "or1200_cpu.operand_b != or1200_cpu.dcpu_dat_o && or1200_cpu.rst == 0",
      "expected_cycles": 1
    }
  ]
}
