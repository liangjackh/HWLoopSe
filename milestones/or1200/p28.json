{
  "target": "Violate p28: wb_insn[31:16]==8192 => lsu_addr==eear",
  "target_expr": "!(!(((or1200_cpu.wb_insn & 32'hFFFF0000) >> 16) == 8192) || or1200_cpu.dcpu_adr_o == or1200_cpu.eear || or1200_cpu.rst == 1)",
  "milestones": [
    {
      "step": 0,
      "description": "Reset asserted",
      "condition": "or1200_cpu.rst == 1",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released",
      "condition": "or1200_cpu.rst == 0",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "Instruction with upper-16==8192 reaches EX stage",
      "condition": "((or1200_cpu.ex_insn & 32'hFFFF0000) >> 16) == 8192",
      "expected_cycles": 3
    },
    {
      "step": 3,
      "description": "Instruction advances to WB stage (wb_insn has upper-16==8192)",
      "condition": "((or1200_cpu.wb_insn & 32'hFFFF0000) >> 16) == 8192",
      "expected_cycles": 1
    },
    {
      "step": 4,
      "description": "Violation: lsu_addr does not equal eear",
      "condition": "((or1200_cpu.wb_insn & 32'hFFFF0000) >> 16) == 8192 && or1200_cpu.dcpu_adr_o != or1200_cpu.eear",
      "expected_cycles": 1
    }
  ]
}