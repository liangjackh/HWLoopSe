      "description": "Violation: or1200_cpu.ex_pc does not match spr_dat_npc",
      "condition": "((or1200_cpu.ex_insn & 32'hC0000000) >> 30) == 1 && or1200_cpu.ex_pc != or1200_cpu.spr_dat_npc",
