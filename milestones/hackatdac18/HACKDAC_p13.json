{
  "target": "Violate HACKDAC_p13: when ctrl_fsm_ns is DECODE (5'b00101), on the next cycle it must NOT still be DECODE. Find a state where DECODE loops back to itself.",
  "target_expr": "top_wrapper.riscv_core.id_stage_i.controller_i.ctrl_fsm_ns == 5'b00101",
  "milestones": [
    {
      "step": 0,
      "description": "System reset applied, controller in RESET state",
      "condition": "rstn_top == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released, controller starts boot sequence (RESET state = 5'b00000)",
      "condition": "rstn_top == 1 && top_wrapper.riscv_core.id_stage_i.controller_i.ctrl_fsm_ns == 5'b00000",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "Controller transitions to BOOT_SET (5'b00001)",
      "condition": "top_wrapper.riscv_core.id_stage_i.controller_i.ctrl_fsm_ns == 5'b00001",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Controller reaches DECODE state (5'b00101)",
      "condition": "top_wrapper.riscv_core.id_stage_i.controller_i.ctrl_fsm_ns == 5'b00101",
      "expected_cycles": 3
    },
    {
      "step": 4,
      "description": "Violation: controller stays in DECODE on next cycle (faulty decoder FSM loops back to DECODE)",
      "condition": "top_wrapper.riscv_core.id_stage_i.controller_i.ctrl_fsm_ns == 5'b00101",
      "expected_cycles": 1
    }
  ]
}
