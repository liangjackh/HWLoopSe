{
  "target": "Violate HACKDAC_p21: output c must never equal temperature_out (temperature sensor must not be muxed with crypto output).",
  "target_expr": "top_wrapper.mux_func.c == top_wrapper.mux_func.temperature_out",
  "milestones": [
    {
      "step": 0,
      "description": "System reset applied",
      "condition": "rstn_top == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released, mux_func module operational",
      "condition": "rstn_top == 1",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "Temperature sensor output has a non-zero value",
      "condition": "top_wrapper.mux_func.temperature_out != 128'h00000000000000000000000000000000",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: output c equals temperature_out (temperature sensor muxed with crypto output via d[3])",
      "condition": "top_wrapper.mux_func.c == top_wrapper.mux_func.temperature_out",
      "expected_cycles": 1
    }
  ]
}
