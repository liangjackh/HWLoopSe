{
  "target": "Violate assertion '(~(((ctrl_ex_insn & 32'hFC000000) >> 26) == 47)) || (rf_we == 0) || (rst == 1)' in or1200_cpu.u_assertions",
  "target_expr": "!((~(((or1200_cpu.u_assertions.ctrl_ex_insn & 32'or1200_cpu.u_assertions.hFC000000) >> 26) == 47)) || (or1200_cpu.u_assertions.rf_we == 0) || (or1200_cpu.u_assertions.rst == 1))",
  "milestones": [
    {
      "step": 0,
      "description": "System reset",
      "condition": "rst == 1"
    },
    {
      "step": 1,
      "description": "Reset deasserted, pipeline starts fetching",
      "condition": "rst == 0"
    },
    {
      "step": 2,
      "description": "Instruction fetch provides a non-NOP instruction to IF stage",
      "condition": "if_insn != 32'h15000000"
    },
    {
      "step": 3,
      "description": "ID stage not frozen, instruction moves from IF to ID",
      "condition": "id_freeze == 0 && id_insn == if_insn"
    },
    {
      "step": 4,
      "description": "ID stage decodes an l.mfspr instruction (opcode 47)",
      "condition": "(id_insn & 32'hFC000000) >> 26 == 47"
    },
    {
      "step": 5,
      "description": "EX stage not frozen, l.mfspr moves from ID to EX",
      "condition": "ex_freeze == 0 && ex_insn == id_insn"
    },
    {
      "step": 6,
      "description": "Register file write enable is asserted (rf_we == 1) while l.mfspr is in EX stage",
      "condition": "rf_we == 1 && ((ex_insn & 32'hFC000000) >> 26 == 47)"
    }
  ]
}