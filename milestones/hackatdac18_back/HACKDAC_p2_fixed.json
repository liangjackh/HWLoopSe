{
  "target": "Violate HACKDAC_p2_fixed: when FC_DATA gets a grant, its address must be in TCDM range [0x1C00_0000, 0x1C08_0000].",
  "target_expr": "top_wrapper.soc_interconnect.FC_DATA_gnt_o == 1 && (top_wrapper.soc_interconnect.FC_DATA_add_i < 32'h1C000000 || top_wrapper.soc_interconnect.FC_DATA_add_i > 32'h1C080000)",
  "milestones": [
    {
      "step": 0,
      "description": "System reset applied",
      "condition": "rstn_top == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released, interconnect operational",
      "condition": "rstn_top == 1",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "FC_DATA master issues a request with an out-of-range address",
      "condition": "top_wrapper.soc_interconnect.FC_DATA_req_i == 1 && top_wrapper.soc_interconnect.FC_DATA_add_i > 32'h1C080000",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: FC_DATA granted but address is outside TCDM range",
      "condition": "top_wrapper.soc_interconnect.FC_DATA_gnt_o == 1 && top_wrapper.soc_interconnect.FC_DATA_add_i > 32'h1C080000",
      "expected_cycles": 1
    }
  ]
}
