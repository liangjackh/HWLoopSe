{
  "target": "Violate HACKDAC_p11: it must never happen that dbg_halt is not asserted while rdata_sel_n selects debug status register (RD_DBGS = 3'b100).",
  "target_expr": "top_wrapper.riscv_core.debug_unit_i.dbg_halt != 1 && top_wrapper.riscv_core.debug_unit_i.rdata_sel_n == 3'b100",
  "milestones": [
    {
      "step": 0,
      "description": "System reset applied",
      "condition": "rstn_top == 0",
      "expected_cycles": 1
    },
    {
      "step": 1,
      "description": "Reset released, debug unit initialized",
      "condition": "rstn_top == 1",
      "expected_cycles": 1
    },
    {
      "step": 2,
      "description": "Core not in halt mode (dbg_halt == 0)",
      "condition": "top_wrapper.riscv_core.debug_unit_i.dbg_halt == 0",
      "expected_cycles": 2
    },
    {
      "step": 3,
      "description": "Violation: debug status register read selected while core is not halted",
      "condition": "top_wrapper.riscv_core.debug_unit_i.dbg_halt != 1 && top_wrapper.riscv_core.debug_unit_i.rdata_sel_n == 3'b100",
      "expected_cycles": 1
    }
  ]
}
