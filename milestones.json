{
  "target": "Violate assertion '\n        ~(((top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR) >> 1) &&\n        ((top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) &&\n         (top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR <= 32'h1C08_0000)))' in jg_bind_inst",
  "target_expr": "~(((top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR) >> 1) &&\n        ((top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) &&\n         (top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR > 32'h1C08_0000)))",
  "milestones": [
    {
      "step": 0,
      "description": "System Reset",
      "condition": "rstn_top == 0",
      "expected_cycles": 10
    },
    {
      "step": 1,
      "description": "Reset released, system active",
      "condition": "rstn_top == 1",
      "expected_cycles": 10
    },
    {
      "step": 2,
      "description": "RISC-V core executes an instruction that triggers division operation",
      "condition": "top_wrapper.riscv_core.ex_stage_i.alu_i.operator_i == 3'b100",
      "expected_cycles": 10
    },
    {
      "step": 3,
      "description": "Division unit becomes active with valid inputs",
      "condition": "top_wrapper.riscv_core.ex_stage_i.alu_i.div_i.div_valid == 1",
      "expected_cycles": 10
    },
    {
      "step": 4,
      "description": "Division unit internal parameter mismatch detected",
      "condition": "top_wrapper.riscv_core.ex_stage_i.alu_i.div_i.C_LOG_WIDTH != 5",
      "expected_cycles": 10
    },
    {
      "step": 5,
      "description": "System Reset",
      "condition": "rstn_top == 0",
      "expected_cycles": 10
    },
    {
      "step": 6,
      "description": "Reset released, system idle",
      "condition": "rstn_top == 1",
      "expected_cycles": 10
    },
    {
      "step": 7,
      "description": "A master initiates a request to the interleaved TCDM region with address in range [0x1C000000, 0x1C080000]",
      "condition": "top_wrapper.soc_interconnect.TCDM_data_req_DEM_TO_XBAR[0] == 1 && top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR[0] >= 32'h1C000000 && top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR[0] <= 32'h1C080000",
      "expected_cycles": 10
    },
    {
      "step": 8,
      "description": "The XBAR_L2 grants the request (gnt bit 0 asserted)",
      "condition": "top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR[0] == 1",
      "expected_cycles": 10
    },
    {
      "step": 9,
      "description": "A second master (or same master) initiates a request to the same interleaved region, address > 0x1C080000",
      "condition": "top_wrapper.soc_interconnect.TCDM_data_req_DEM_TO_XBAR[1] == 1 && top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR[1] > 32'h1C080000",
      "expected_cycles": 10
    },
    {
      "step": 10,
      "description": "The XBAR_L2 grants the second request (gnt bit 1 asserted), creating the violation condition",
      "condition": "top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR[1] == 1",
      "expected_cycles": 10
    }
  ]
}