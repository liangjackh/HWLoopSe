{
  "target": "Violate assertion '(operand_b == dcpu_dat_o) || (rst == 1)' in or1200_cpu.u_assertions",
  "target_expr": "!((or1200_cpu.u_assertions.operand_b == or1200_cpu.u_assertions.dcpu_dat_o) || (or1200_cpu.u_assertions.rst == 1))",
  "milestones": [
    {
      "step": 0,
      "description": "System Reset",
      "condition": "rst == 1"
    },
    {
      "step": 1,
      "description": "Reset deasserted, pipeline starts",
      "condition": "rst == 0"
    },
    {
      "step": 2,
      "description": "Instruction fetch provides an instruction that will cause operand_b to be loaded from register file",
      "condition": "or1200_cpu.icpu_dat_i[31:26] == 6'b000000 && or1200_cpu.icpu_dat_i[5:0] == 6'b100000"
    },
    {
      "step": 3,
      "description": "Instruction decoded, sel_b selects RF (default), id_freeze is low to allow operand mux update",
      "condition": "or1200_cpu.sel_b == 2'b00 && or1200_cpu.id_freeze == 0"
    },
    {
      "step": 4,
      "description": "Register file read port B provides a non-zero value",
      "condition": "or1200_cpu.rf_datab != 0"
    },
    {
      "step": 5,
      "description": "Operand mux sets muxed_b to rf_datab (since sel_b is default)",
      "condition": "or1200_cpu.or1200_operandmuxes.muxed_b == or1200_cpu.rf_datab"
    },
    {
      "step": 6,
      "description": "ex_freeze is low, saved_b is low, so operand_b register updates with muxed_b",
      "condition": "or1200_cpu.ex_freeze == 0 && or1200_cpu.or1200_operandmuxes.saved_b == 0"
    },
    {
      "step": 7,
      "description": "operand_b now holds the value from rf_datab",
      "condition": "or1200_cpu.operand_b == or1200_cpu.rf_datab"
    },
    {
      "step": 8,
      "description": "A store instruction reaches execute stage, setting dcpu_dat_o to operand_b",
      "condition": "or1200_cpu.id_lsu_op == 4'b0101 && or1200_cpu.ex_freeze == 0"
    },
    {
      "step": 9,
      "description": "dcpu_dat_o is driven with operand_b value",
      "condition": "or1200_cpu.dcpu_dat_o == or1200_cpu.operand_b"
    },
    {
      "step": 10,
      "description": "Verification target: operand_b equals dcpu_dat_o and rst is 0",
      "condition": "or1200_cpu.u_assertions.operand_b == or1200_cpu.u_assertions.dcpu_dat_o && or1200_cpu.u_assertions.rst == 0"
    }
  ]
}