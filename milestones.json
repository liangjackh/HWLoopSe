{
  "target": "Violate assertion '\n        (~((top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR) >> 1) && \n        ((top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) && \n         (top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR <= 32'h1C08_0000)))' in jg_bind_inst",
  "target_expr": "(~((top_wrapper.soc_interconnect.TCDM_data_gnt_DEM_TO_XBAR) >> 1) && \n        ((top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR >= 32'h1C00_0000) && \n         (top_wrapper.soc_interconnect.TCDM_data_add_DEM_TO_XBAR > 32'h1C08_0000)))",
  "milestones": [
    {
      "step": 0,
      "description": "System reset: all modules in reset state",
      "condition": "rst_n == 0",
      "expected_cycles": 10
    },
    {
      "step": 1,
      "description": "Reset deasserted, system active",
      "condition": "rst_n == 1",
      "expected_cycles": 10
    },
    {
      "step": 2,
      "description": "RISC-V core executes an instruction that triggers ALU division operation",
      "condition": "riscv_core.ex_stage_i.alu_i.operator_i == 5 || riscv_core.ex_stage_i.alu_i.operator_i == 6 || riscv_core.ex_stage_i.alu_i.operator_i == 7",
      "expected_cycles": 10
    },
    {
      "step": 3,
      "description": "ALU division module becomes active with valid inputs",
      "condition": "riscv_core.ex_stage_i.alu_i.div_i.div_valid == 1",
      "expected_cycles": 10
    },
    {
      "step": 4,
      "description": "Division operation completes or reaches a state where C_LOG_WIDTH is defined",
      "condition": "riscv_core.ex_stage_i.alu_i.div_i.C_LOG_WIDTH != (riscv_core.ex_stage_i.alu_i.div_i.C_WIDTH + 1)",
      "expected_cycles": 10
    },
    {
      "step": 5,
      "description": "System reset",
      "condition": "rst_n == 0",
      "expected_cycles": 10
    },
    {
      "step": 6,
      "description": "Reset deasserted, system ready",
      "condition": "rst_n == 1",
      "expected_cycles": 10
    },
    {
      "step": 7,
      "description": "A master initiates a request to TCDM region (address within 0x1C000000 to 0x1C080000). For example, FC_DATA_req_i asserted with FC_DATA_add_i in range.",
      "condition": "FC_DATA_req_i == 1 && FC_DATA_add_i >= 32'h1C000000 && FC_DATA_add_i <= 32'h1C080000",
      "expected_cycles": 10
    },
    {
      "step": 8,
      "description": "Request propagates through demux to TCDM_data_req_DEM_TO_XBAR for master index 0 (FC_DATA).",
      "condition": "TCDM_data_req_DEM_TO_XBAR[0] == 1 && TCDM_data_add_DEM_TO_XBAR[0] >= 32'h1C000000 && TCDM_data_add_DEM_TO_XBAR[0] <= 32'h1C080000",
      "expected_cycles": 10
    },
    {
      "step": 9,
      "description": "XBAR_L2 grants the request (gnt asserted for master 0).",
      "condition": "TCDM_data_gnt_DEM_TO_XBAR[0] == 1",
      "expected_cycles": 10
    },
    {
      "step": 10,
      "description": "Grant signal is high for master 0, but the target condition requires that the grant vector shifted right by 1 is zero (i.e., no grant for master index 1). Ensure no other master (index 1) is granted simultaneously.",
      "condition": "TCDM_data_gnt_DEM_TO_XBAR[0] == 1 && TCDM_data_gnt_DEM_TO_XBAR[1] == 0",
      "expected_cycles": 10
    },
    {
      "step": 11,
      "description": "Final target state: Grant vector shifted right by 1 is zero (no grant for master 1) and address for master 0 is within TCDM range (>=0x1C000000 and >0x1C080000). Note: The target condition uses > 0x1C080000, but the valid TCDM range ends at 0x1C082000. To satisfy >0x1C080000, we need an address between 0x1C080001 and 0x1C082000.",
      "condition": "(TCDM_data_gnt_DEM_TO_XBAR >> 1) == 0 && TCDM_data_add_DEM_TO_XBAR[0] >= 32'h1C000000 && TCDM_data_add_DEM_TO_XBAR[0] > 32'h1C080000 && TCDM_data_add_DEM_TO_XBAR[0] <= 32'h1C082000",
      "expected_cycles": 10
    }
  ]
}